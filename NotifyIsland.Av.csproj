<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>NotifyIsland</RootNamespace>
    <AssemblyName>NotifyIsland</AssemblyName>
    <PublishTrimmed>false</PublishTrimmed>
    <Version>1.3.3</Version>
    <Description>NotifyIsland Avalonia top-center overlay for Windows 11</Description>
    <Authors>Leorik69</Authors>
    <DefaultItemExcludes>$(DefaultItemExcludes);NotifyIsland.Core\**;NotifyIsland.Tests\**</DefaultItemExcludes>
  </PropertyGroup>
  <!-- Self-contained only when publishing with an RID or publish profile -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' Or '$(PublishProfile)' != ''">
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="NotifyIsland.Core\NotifyIsland.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
  </ItemGroup>
</Project>
