<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NotifyIsland.SettingsWindow"
        Title="NotifyIsland settings"
        Width="640" Height="720"
        CanResize="True" MinWidth="580" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="Full"
        ShowInTaskbar="True">
  <Window.Styles>
    <Style Selector="NumericUpDown">
      <Setter Property="MinWidth" Value="172"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Right"/>
      <Setter Property="Padding" Value="8,4,4,4"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="ShowButtonSpinner" Value="True"/>
      <Setter Property="ButtonSpinnerLocation" Value="Right"/>
    </Style>
    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
      <Setter Property="MinWidth" Value="96"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="Padding" Value="8,4,8,4"/>
      <Setter Property="HorizontalContentAlignment" Value="Right"/>
    </Style>
    <Style Selector="NumericUpDown /template/ RepeatButton">
      <Setter Property="MinWidth" Value="18"/>
      <Setter Property="Width" Value="22"/>
      <Setter Property="MaxWidth" Value="24"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="TextBlock.unit">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="Opacity" Value="0.75"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
  </Window.Styles>
  <DockPanel Margin="16">
    <TextBlock x:Name="HeadingText" DockPanel.Dock="Top" FontSize="20" FontWeight="SemiBold" Text="Капсула" Margin="0,0,0,8"
               FontFamily="Segoe UI Variable Display, Segoe UI" />
    <TextBlock x:Name="PathHint" DockPanel.Dock="Bottom" FontSize="11" Opacity="0.65" TextWrapping="Wrap" Margin="0,8,0,0" />
    <ScrollViewer>
      <StackPanel Spacing="8">
        <Border x:Name="WhatsNewBox" Padding="12" CornerRadius="8" Margin="0,0,0,8"
                Background="#22FFFFFF" BorderBrush="#44FFFFFF" BorderThickness="1">
          <StackPanel Spacing="6">
            <TextBlock x:Name="WhatsNewTitle" FontWeight="SemiBold" />
            <TextBlock x:Name="WhatsNewBody" FontSize="12" Opacity="0.85" TextWrapping="Wrap" />
            <Button x:Name="WhatsNewOk" HorizontalAlignment="Left" Click="OnWhatsNewOk" />
          </StackPanel>
        </Border>
        <Border x:Name="PreviewPill" Height="48" CornerRadius="24" Padding="16,0">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Path x:Name="PreviewIcon" Width="16" Height="16" Stretch="Uniform" />
            <TextBlock x:Name="PreviewClock" FontSize="14" FontWeight="SemiBold" Text="12:34" />
          </StackPanel>
        </Border>

        <Expander x:Name="AppearanceExp" Header="Вид" IsExpanded="True">
          <StackPanel Spacing="8" Margin="0,8,0,0">
            <TextBlock x:Name="LangLabel" Opacity="0.8" />
            <TextBlock x:Name="LangHint" FontSize="11" Opacity="0.65" TextWrapping="Wrap" />
            <ComboBox x:Name="LangBox" HorizontalAlignment="Stretch" SelectionChanged="OnChanged" />
            <TextBlock Text="Palette" Opacity="0.8" />
            <ComboBox x:Name="PaletteBox" HorizontalAlignment="Stretch" SelectionChanged="OnChanged" />
            <TextBlock Text="Custom accent (#RRGGBB, empty = palette)" Opacity="0.8" />
            <TextBox x:Name="AccentBox" Watermark="#3D9CF0" LostFocus="OnCityLost" />
            <TextBlock Text="Font" Opacity="0.8" />
            <ComboBox x:Name="FontBox" HorizontalAlignment="Stretch" SelectionChanged="OnChanged" />
            <TextBlock Text="Icons" Opacity="0.8" />
            <ComboBox x:Name="IconBox" HorizontalAlignment="Stretch" SelectionChanged="OnChanged" />
            <Grid ColumnDefinitions="*,172,48">
              <TextBlock Text="Opacity" VerticalAlignment="Center" />
              <NumericUpDown x:Name="OpacityNum" Grid.Column="1" Minimum="0.45" Maximum="1" Increment="0.01" FormatString="0.00" ValueChanged="OnNum" />
              <TextBlock Grid.Column="2" Classes="unit" Text="%" />
            </Grid>
            <Slider x:Name="OpacitySlider" Minimum="0.45" Maximum="1" PropertyChanged="OnSlider" />
            <Grid ColumnDefinitions="*,172,48">
              <TextBlock Text="Glass (alpha only)" VerticalAlignment="Center" />
              <NumericUpDown x:Name="GlassNum" Grid.Column="1" Minimum="0" Maximum="1" Increment="0.05" FormatString="0.00" ValueChanged="OnNum" />
              <TextBlock Grid.Column="2" Classes="unit" Text="%" />
            </Grid>
            <Slider x:Name="GlassSlider" Minimum="0" Maximum="1" PropertyChanged="OnSlider" />
            <Grid ColumnDefinitions="*,172,48">
              <TextBlock Text="Border" VerticalAlignment="Center" />
              <NumericUpDown x:Name="BorderNum" Grid.Column="1" Minimum="0" Maximum="3" Increment="0.1" FormatString="0.0" ValueChanged="OnNum" />
              <TextBlock Grid.Column="2" Classes="unit" Text="px" />
            </Grid>
            <Slider x:Name="BorderSlider" Minimum="0" Maximum="3" PropertyChanged="OnSlider" />
            <Grid ColumnDefinitions="*,172,48">
              <TextBlock Text="Glow" VerticalAlignment="Center" />
              <NumericUpDown x:Name="GlowNum" Grid.Column="1" Minimum="0" Maximum="1" Increment="0.05" FormatString="0.00" ValueChanged="OnNum" />
              <TextBlock Grid.Column="2" Classes="unit" Text="%" />
            </Grid>
            <Slider x:Name="GlowSlider" Minimum="0" Maximum="1" PropertyChanged="OnSlider" />
            <Grid ColumnDefinitions="*,172,48">
              <TextBlock Text="Corner radius (0=auto)" VerticalAlignment="Center" />
              <NumericUpDown x:Name="RadiusNum" Grid.Column="1" Minimum="0" Maximum="28" Increment="1" FormatString="0" ValueChanged="OnNum" />
              <TextBlock Grid.Column="2" Classes="unit" Text="px" />
            </Grid>
            <Slider x:Name="RadiusSlider" Minimum="0" Maximum="28" PropertyChanged="OnSlider" />
            <TextBlock x:Name="RenderModeLabel" Opacity="0.8" />
            <TextBlock x:Name="RenderModeHint" FontSize="11" Opacity="0.65" TextWrapping="Wrap" />
            <ComboBox x:Name="RenderModeBox" HorizontalAlignment="Stretch" SelectionChanged="OnChanged" />
            <TextBlock x:Name="MotionExtraLabel" Opacity="0.8" />
            <TextBlock x:Name="MotionExtraHint" FontSize="11" Opacity="0.65" TextWrapping="Wrap" />
            <ComboBox x:Name="AnimBox" HorizontalAlignment="Stretch" SelectionChanged="OnChanged" />
            <TextBlock x:Name="ExpandSpeedLabel" Opacity="0.8" />
            <TextBlock x:Name="ExpandSpeedHint" FontSize="11" Opacity="0.65" TextWrapping="Wrap" />
            <ComboBox x:Name="ExpandSpeedBox" HorizontalAlignment="Stretch" SelectionChanged="OnExpandPreset" />
            <Grid ColumnDefinitions="*,172,48">
              <Slider x:Name="ExpandMsSlider" Minimum="120" Maximum="500" PropertyChanged="OnSlider" />
              <NumericUpDown x:Name="ExpandMsNum" Grid.Column="1" Minimum="120" Maximum="500" Increment="1" FormatString="0" ValueChanged="OnNum" />
              <TextBlock Grid.Column="2" Classes="unit" Text="мс" />
            </Grid>
            <TextBlock x:Name="CollapseSpeedLabel" Opacity="0.8" />
            <TextBlock x:Name="CollapseSpeedHint" FontSize="11" Opacity="0.65" TextWrapping="Wrap" />
            <ComboBox x:Name="CollapseSpeedBox" HorizontalAlignment="Stretch" SelectionChanged="OnCollapsePreset" />
            <Grid ColumnDefinitions="*,172,48">
              <Slider x:Name="CollapseMsSlider" Minimum="180" Maximum="600" PropertyChanged="OnSlider" />
              <NumericUpDown x:Name="CollapseMsNum" Grid.Column="1" Minimum="180" Maximum="600" Increment="1" FormatString="0" ValueChanged="OnNum" />
              <TextBlock Grid.Column="2" Classes="unit" Text="мс" />
            </Grid>
          </StackPanel>
        </Expander>

        <Expander Header="Capsule">
          <StackPanel Spacing="8" Margin="0,8,0,0">
            <TextBlock Text="Clock format" Opacity="0.8" />
            <ComboBox x:Name="ClockBox" HorizontalAlignment="Stretch" SelectionChanged="OnChanged" />
            <TextBlock Text="Density" Opacity="0.8" />
            <ComboBox x:Name="DensityBox" HorizontalAlignment="Stretch" SelectionChanged="OnChanged" />
            <Grid ColumnDefinitions="*,172,48">
              <TextBlock Text="Idle width" VerticalAlignment="Center" />
              <NumericUpDown x:Name="WidthNum" Grid.Column="1" Minimum="140" Maximum="280" Increment="1" FormatString="0" ValueChanged="OnNum" />
              <TextBlock Grid.Column="2" Classes="unit" Text="px" />
            </Grid>
            <Slider x:Name="WidthSlider" Minimum="140" Maximum="280" PropertyChanged="OnSlider" />
            <Grid ColumnDefinitions="*,172,48">
              <TextBlock Text="Capsule height" VerticalAlignment="Center" />
              <NumericUpDown x:Name="HeightNum" Grid.Column="1" Minimum="32" Maximum="48" Increment="1" FormatString="0" ValueChanged="OnNum" />
              <TextBlock Grid.Column="2" Classes="unit" Text="px" />
            </Grid>
            <Slider x:Name="HeightSlider" Minimum="32" Maximum="48" PropertyChanged="OnSlider" />
            <CheckBox x:Name="ExpandHeightBox" Content="Expand height (off = width only)" IsCheckedChanged="OnCheck" />
            <Grid ColumnDefinitions="*,172,48">
              <TextBlock Text="Min width" VerticalAlignment="Center" />
              <NumericUpDown x:Name="MinWNum" Grid.Column="1" Minimum="120" Maximum="360" Increment="1" FormatString="0" ValueChanged="OnNum" />
              <TextBlock Grid.Column="2" Classes="unit" Text="px" />
            </Grid>
            <Slider x:Name="MinWSlider" Minimum="120" Maximum="360" PropertyChanged="OnSlider" />
            <Grid ColumnDefinitions="*,172,48">
              <TextBlock Text="Max width" VerticalAlignment="Center" />
              <NumericUpDown x:Name="MaxWNum" Grid.Column="1" Minimum="200" Maximum="640" Increment="1" FormatString="0" ValueChanged="OnNum" />
              <TextBlock Grid.Column="2" Classes="unit" Text="px" />
            </Grid>
            <Slider x:Name="MaxWSlider" Minimum="200" Maximum="640" PropertyChanged="OnSlider" />
            <TextBlock Text="Text size" Opacity="0.8" />
            <ComboBox x:Name="TextSizeBox" HorizontalAlignment="Stretch" SelectionChanged="OnChanged" />
            <TextBlock Text="Icon size" Opacity="0.8" />
            <ComboBox x:Name="IconSizeBox" HorizontalAlignment="Stretch" SelectionChanged="OnChanged" />
            <CheckBox x:Name="BadgeBox" Content="Show app badge left of clock" IsCheckedChanged="OnCheck" />
            <TextBlock Text="Badge style" Opacity="0.8" />
            <ComboBox x:Name="BadgeStyleBox" HorizontalAlignment="Stretch" SelectionChanged="OnChanged" />
          </StackPanel>
        </Expander>

        <Expander Header="Position / layer">
          <StackPanel Spacing="8" Margin="0,8,0,0">
            <ComboBox x:Name="AnchorHBox" HorizontalAlignment="Stretch" SelectionChanged="OnChanged" />
            <ComboBox x:Name="AnchorVBox" HorizontalAlignment="Stretch" SelectionChanged="OnChanged" />
            <Grid ColumnDefinitions="*,172,48">
              <TextBlock Text="X offset" VerticalAlignment="Center" />
              <NumericUpDown x:Name="OffXNum" Grid.Column="1" Minimum="-400" Maximum="400" Increment="1" FormatString="0" ValueChanged="OnNum" />
              <TextBlock Grid.Column="2" Classes="unit" Text="px" />
            </Grid>
            <Slider x:Name="OffXSlider" Minimum="-400" Maximum="400" PropertyChanged="OnSlider" />
            <Grid ColumnDefinitions="*,172,48">
              <TextBlock Text="Y offset" VerticalAlignment="Center" />
              <NumericUpDown x:Name="OffYNum" Grid.Column="1" Minimum="-400" Maximum="400" Increment="1" FormatString="0" ValueChanged="OnNum" />
              <TextBlock Grid.Column="2" Classes="unit" Text="px" />
            </Grid>
            <Slider x:Name="OffYSlider" Minimum="-400" Maximum="400" PropertyChanged="OnSlider" />
            <ComboBox x:Name="LayerBox" HorizontalAlignment="Stretch" SelectionChanged="OnChanged" />
            <TextBlock Text="Display" Opacity="0.8" />
            <ComboBox x:Name="ScreenBox" HorizontalAlignment="Stretch" SelectionChanged="OnChanged" />
            <CheckBox x:Name="QuietFocusBox" Content="Pause toasts during Focus Assist" IsCheckedChanged="OnCheck" />
            <CheckBox x:Name="QuietFullBox" Content="Pause toasts during fullscreen / presentation" IsCheckedChanged="OnCheck" />
            <CheckBox x:Name="ReduceMotionBox" Content="Reduce motion" IsCheckedChanged="OnCheck" />
            <CheckBox x:Name="DiagBox" Content="Diagnostics HUD" IsCheckedChanged="OnCheck" />
            <TextBlock Text="Desktop layer uses HWND_BOTTOM. WorkerW is not used." FontSize="11" Opacity="0.65" TextWrapping="Wrap" />
          </StackPanel>
        </Expander>

        <Expander Header="Weather">
          <StackPanel Spacing="8" Margin="0,8,0,0">
            <CheckBox x:Name="WeatherBox" Content="Show weather (Open-Meteo)" IsCheckedChanged="OnCheck" />
            <CheckBox x:Name="LocationBox" Content="Use Windows location when allowed" IsCheckedChanged="OnCheck" />
            <TextBox x:Name="CityBox" Watermark="City fallback" LostFocus="OnCityLost" />
            <ComboBox x:Name="WeatherPosBox" HorizontalAlignment="Stretch" SelectionChanged="OnChanged" />
            <Grid ColumnDefinitions="*,172,48">
              <TextBlock Text="Refresh (min)" VerticalAlignment="Center" />
              <NumericUpDown x:Name="WeatherMinNum" Grid.Column="1" Minimum="5" Maximum="60" Increment="1" FormatString="0" ValueChanged="OnNum" />
              <TextBlock Grid.Column="2" Classes="unit" Text="мин" />
            </Grid>
            <Slider x:Name="WeatherMinSlider" Minimum="5" Maximum="60" PropertyChanged="OnSlider" />
            <TextBlock x:Name="WeatherStatus" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
          </StackPanel>
        </Expander>

        <Expander Header="Sounds">
          <StackPanel Spacing="8" Margin="0,8,0,0">
            <CheckBox x:Name="SoundBox" Content="Sounds on" IsCheckedChanged="OnCheck" />
            <CheckBox x:Name="SoundNotifyBox" Content="Notify" IsCheckedChanged="OnCheck" />
            <CheckBox x:Name="SoundChatBox" Content="Chat" IsCheckedChanged="OnCheck" />
            <CheckBox x:Name="SoundErrorBox" Content="Error" IsCheckedChanged="OnCheck" />
            <CheckBox x:Name="SoundCompleteBox" Content="Complete" IsCheckedChanged="OnCheck" />
            <Grid ColumnDefinitions="*,172,48">
              <TextBlock Text="Cue volume (app sounds)" VerticalAlignment="Center" />
              <NumericUpDown x:Name="VolumeNum" Grid.Column="1" Minimum="0" Maximum="1" Increment="0.02" FormatString="0.00" ValueChanged="OnNum" />
              <TextBlock Grid.Column="2" Classes="unit" Text="%" />
            </Grid>
            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" PropertyChanged="OnSlider" />
            <Button Content="Preview notify sound" Click="OnPreviewSound" HorizontalAlignment="Left" />
            <TextBlock Text="System master volume (also in player panel)" Opacity="0.8" Margin="0,8,0,0" />
            <Grid ColumnDefinitions="*,172,48">
              <Slider x:Name="SysVolSlider" Minimum="0" Maximum="1" PropertyChanged="OnSysVol" />
              <NumericUpDown x:Name="SysVolNum" Grid.Column="1" Minimum="0" Maximum="1" Increment="0.01" FormatString="0.00" ValueChanged="OnSysVolNum" />
              <TextBlock Grid.Column="2" Classes="unit" Text="%" />
            </Grid>
            <CheckBox x:Name="SysMuteBox" Content="Mute system" IsCheckedChanged="OnSysMute" />
            <TextBlock x:Name="SysVolStatus" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
          </StackPanel>
        </Expander>

        <Expander Header="Notifications">
          <StackPanel Spacing="8" Margin="0,8,0,0">
            <TextBlock Text="Capsule click" Opacity="0.8" />
            <ComboBox x:Name="ClickBox" HorizontalAlignment="Stretch" SelectionChanged="OnChanged" />
            <CheckBox x:Name="ActionCenterBox" Content="Legacy: click opens Notification Center" IsVisible="False" IsCheckedChanged="OnCheck" />
            <CheckBox x:Name="HoverBox" IsCheckedChanged="OnCheck" />
            <TextBlock x:Name="HoverHint" FontSize="11" Opacity="0.65" TextWrapping="Wrap" />
            <CheckBox x:Name="AutoBox" IsCheckedChanged="OnCheck" />
            <CheckBox x:Name="ToastBox" IsCheckedChanged="OnCheck" />
            <TextBlock x:Name="ToastHint" FontSize="11" Opacity="0.65" TextWrapping="Wrap" />
            <TextBlock x:Name="ToastStatus" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
            <Button x:Name="OpenToastBtn" Click="OnOpenToastSettings" HorizontalAlignment="Left" />
            <Button x:Name="OpenPrivacyBtn" Click="OnOpenToastPrivacy" HorizontalAlignment="Left" />
            <TextBlock x:Name="BadgeAppsLabel" Opacity="0.8" />
            <TextBlock x:Name="BadgeAppsHint" FontSize="11" Opacity="0.65" TextWrapping="Wrap" />
            <TextBox x:Name="BadgeAppsBox" LostFocus="OnCityLost" />
            <Grid ColumnDefinitions="*,172,48">
              <TextBlock x:Name="NotifyMsLabel" VerticalAlignment="Center" />
              <NumericUpDown x:Name="NotifyNum" Grid.Column="1" Minimum="1000" Maximum="8000" Increment="100" FormatString="0" ValueChanged="OnNum" />
              <TextBlock Grid.Column="2" Classes="unit" Text="мс" />
            </Grid>
            <Slider x:Name="NotifySlider" Minimum="1000" Maximum="8000" PropertyChanged="OnSlider" />
            <Grid ColumnDefinitions="*,172,48">
              <TextBlock Text="Chat ms" VerticalAlignment="Center" />
              <NumericUpDown x:Name="ChatNum" Grid.Column="1" Minimum="800" Maximum="8000" Increment="100" FormatString="0" ValueChanged="OnNum" />
              <TextBlock Grid.Column="2" Classes="unit" Text="мс" />
            </Grid>
            <Slider x:Name="ChatSlider" Minimum="800" Maximum="8000" PropertyChanged="OnSlider" />
            <Grid ColumnDefinitions="*,172,48">
              <TextBlock Text="Call ms" VerticalAlignment="Center" />
              <NumericUpDown x:Name="CallNum" Grid.Column="1" Minimum="1000" Maximum="12000" Increment="100" FormatString="0" ValueChanged="OnNum" />
              <TextBlock Grid.Column="2" Classes="unit" Text="мс" />
            </Grid>
            <Slider x:Name="CallSlider" Minimum="1000" Maximum="12000" PropertyChanged="OnSlider" />
            <Button Content="Preview notify animation" Click="OnPreviewAnim" HorizontalAlignment="Left" />
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
