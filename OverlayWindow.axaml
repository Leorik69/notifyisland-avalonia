<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NotifyIsland.OverlayWindow"
        Title="NotifyIsland"
        Width="170" Height="30"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="#080808"
        Background="Transparent"
        WindowStartupLocation="Manual">
  <Border x:Name="Pill"
          Width="170" Height="30"
          CornerRadius="15"
          Background="#080808"
          BorderBrush="#28FFFFFF"
          BorderThickness="1"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          ClipToBounds="False"
          RenderTransformOrigin="50%,50%">
    <Grid>
      <!-- Collapsed: visible ‹/› chevrons + clock/date/weather + unread dot.
           System-stats metrics live in SystemStatsPanel (expanded view only, 1.12.1).
           When clipboard cycle is active (≥2 items), clock is hidden and the
           preview + nav hint take its place; chevrons appear as clickable
           cycle-prev / cycle-next buttons on the edges. -->
      <StackPanel x:Name="CollapsedRow"
                  Orientation="Horizontal"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="6">
        <Button x:Name="CyclePrevButton"
                Classes="cycleChevron"
                VerticalAlignment="Center"
                Padding="6,0"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="#9CC4FF"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                ToolTip.Tip="Предыдущий режим"
                Click="OnCyclePrevClick"
                Content="‹" />
        <TextBlock x:Name="ClockText"
                   VerticalAlignment="Center"
                   FontFamily="Segoe UI Variable, Inter, Segoe UI"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="#FFFFFF"
                   Text="00:00" />
        <TextBlock x:Name="CyclePreviewText"
                   VerticalAlignment="Center"
                   FontFamily="Segoe UI Variable, Inter, Segoe UI"
                   FontSize="11"
                   FontWeight="Medium"
                   Foreground="#FFFFFF"
                   IsVisible="False"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="240"
                   Text="preview" />
        <TextBlock x:Name="CycleNavHint"
                   VerticalAlignment="Center"
                   FontFamily="Segoe UI Variable, Inter, Segoe UI"
                   FontSize="10"
                   FontWeight="Medium"
                   Foreground="#888890"
                   IsVisible="False"
                   Text="1/3" />
        <Button x:Name="CycleNextButton"
                Classes="cycleChevron"
                VerticalAlignment="Center"
                Padding="6,0"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="#9CC4FF"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                ToolTip.Tip="Следующий режим"
                Click="OnCycleNextClick"
                Content="›" />
        <!-- FontAudio digital segments (HH:mm[:ss]); toggled vs ClockText via DigitalClockEnabled -->
        <StackPanel x:Name="DigitalClockRow"
                    Orientation="Horizontal"
                    Spacing="1"
                    VerticalAlignment="Center"
                    IsVisible="False"
                    IsHitTestVisible="False" />
        <TextBlock x:Name="DateText"
                   VerticalAlignment="Center"
                   FontFamily="Segoe UI Variable, Inter, Segoe UI"
                   FontSize="11"
                   FontWeight="Medium"
                   Foreground="#C8C8CC"
                   Text="24 сен" />
        <StackPanel x:Name="MinimalWeather"
                    Orientation="Horizontal"
                    Spacing="4"
                    VerticalAlignment="Center"
                    IsVisible="False">
          <Grid Width="12" Height="12" VerticalAlignment="Center">
            <Viewbox x:Name="WeatherIconA" Width="12" Height="12" Opacity="1" />
            <Viewbox x:Name="WeatherIconB" Width="12" Height="12" Opacity="0" />
          </Grid>
          <TextBlock x:Name="WeatherTempText"
                     VerticalAlignment="Center"
                     FontFamily="Segoe UI Variable, Inter, Segoe UI"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="#C8C8CC"
                     Text="18°" />
        </StackPanel>
        <StackPanel x:Name="MinimalBattery"
                    Orientation="Horizontal"
                    Spacing="3"
                    VerticalAlignment="Center"
                    IsVisible="False">
          <Viewbox x:Name="BatteryIconHost" Width="11" Height="11" VerticalAlignment="Center" />
          <TextBlock x:Name="BatteryPercentText"
                     VerticalAlignment="Center"
                     FontFamily="Segoe UI Variable, Inter, Segoe UI"
                     FontSize="11"
                     FontWeight="SemiBold"
                     Foreground="#C8C8CC"
                     Text="100%" />
        </StackPanel>
        <Border x:Name="UnreadDot"
                Width="7" Height="7"
                CornerRadius="3.5"
                Background="#5CB6FF"
                VerticalAlignment="Center"
                Opacity="0"
                IsHitTestVisible="False"
                BoxShadow="0 0 12 4 #E05CB6FF" />
        <Border x:Name="PinnedBadge"
                IsVisible="False"
                CornerRadius="4"
                Background="#28FFFFFF"
                Padding="4,1"
                VerticalAlignment="Center">
          <TextBlock Text="закреп"
                     FontFamily="Segoe UI Variable, Inter, Segoe UI"
                     FontSize="9"
                     FontWeight="SemiBold"
                     Foreground="#C8C8CC" />
        </Border>
      </StackPanel>

      <!-- 1.12.2 split clipboard half. Sibling of CollapsedRow inside the same Pill Border,
           so the capsule keeps one shared corner radius and one hit region. Hidden until
           Paint() sees OverlaySnapshot.IsSplitClipboard. The half is anchored at the far end
           of the pill's LONG axis — right on Top/Bottom, bottom on Left/Right — and adds no
           length of its own: the pill already grew in ApplySize, and the divider is a 1 px
           line centred on the existing boundary (negative half-line margin), never a spacer.
           The numbers below are the horizontal defaults only; ApplyClipboardHalfLayout()
           drives the whole block from IslandLayout.IsVertical and ClipboardSplit, so a
           vertical edge gets a 30×200 half on the long axis instead of a 200×30 one. -->
      <Grid x:Name="ClipboardHalf"
            IsVisible="False"
            IsHitTestVisible="False"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Width="200"
            Height="30">
       <!-- 1.12.2 transform ownership. Three writers need a transform at once and must not
            clobber each other, so they live on three different elements:
              · ClipboardHalfContent → the orientation (RotateTransform on a vertical edge,
                                      so a 200-DIP run of text fits the 30-DIP cross axis)
              · ClipboardHalf        → the 200 ms breathe, on the CROSS axis
                                      (TranslateTransform.Y horizontal / .X vertical)
              · ClipboardHalfMotion  → the 16 ms morph, TranslateTransform along the LONG
                                      axis (X horizontal / Y vertical) + ScaleTransform
            The morph is the only element it touches, and the axis it writes is the one the
            breathe never writes, so the two can never collide on either orientation. -->
       <Grid x:Name="ClipboardHalfMotion"
             RenderTransformOrigin="50%,50%">
        <!-- Boundary line. Thickness 1 centred on the half start, with a negative half-thickness
             margin taken from ClipboardSplit.DividerFor so the two halves read as one capsule.
             The 8 DIP ClipboardHalfGap stays inner padding (4 DIP per half) instead of extra
             length. Horizontal here; ApplyClipboardHalfLayout() makes it a horizontal line
             spanning 16 DIP of the cross axis on Left/Right. -->
        <Border x:Name="ClipboardHalfDivider"
                Width="1" Height="16"
                Background="#1AFFFFFF"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                IsHitTestVisible="False" />
        <!-- 4 DIP clearance from the divider, then icon + trimmed preview. MaxWidth keeps
             the TextBlock inside the half so CharacterEllipsis does the trimming. On a vertical
             edge this stays a 200×30 row and is rotated as a whole, so the trimming budget
             (ClipboardHalfPreview.TextMaxChars, MaxWidth 166) is unchanged. -->
        <StackPanel x:Name="ClipboardHalfContent"
                    Orientation="Horizontal"
                    Spacing="4"
                    VerticalAlignment="Center"
                    RenderTransformOrigin="50%,50%"
                    Margin="4,0,10,0">
          <Viewbox x:Name="ClipboardHalfIcon" Width="12" Height="12" VerticalAlignment="Center" />
          <TextBlock x:Name="ClipboardHalfText"
                     VerticalAlignment="Center"
                     FontFamily="Segoe UI Variable, Inter, Segoe UI"
                     FontSize="11"
                     FontWeight="Medium"
                     Foreground="#C8C8CC"
                     MaxWidth="166"
                     TextTrimming="CharacterEllipsis"
                     Text="буфер" />
        </StackPanel>
       </Grid>
      </Grid>

      <!-- Expanded single-row: icon | title/subtitle | badge | (system-stats expanded when SystemStats kind) -->
      <DockPanel x:Name="OverlayPanel"
                 Margin="10,0,10,0"
                 IsVisible="False"
                 VerticalAlignment="Center">
        <Border x:Name="AppIcon"
                DockPanel.Dock="Left"
                Width="18" Height="18"
                CornerRadius="5"
                Background="#3D9CF0"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                ClipToBounds="True">
          <Grid>
            <Viewbox x:Name="AppIconHost" Width="11" Height="11"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Image x:Name="MediaArtwork"
                   Stretch="UniformToFill"
                   IsVisible="False"
                   IsHitTestVisible="False"/>
          </Grid>
        </Border>

        <Border x:Name="UnreadBadge"
                DockPanel.Dock="Right"
                MinWidth="18" Height="18"
                CornerRadius="9"
                Background="#3D9CF0"
                Padding="5,0"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                IsVisible="False">
          <TextBlock x:Name="BadgeText"
                     FontFamily="Segoe UI Variable, Inter, Segoe UI"
                     FontSize="10"
                     FontWeight="SemiBold"
                     Foreground="#FFFFFF"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Text="1" />
        </Border>

        <StackPanel x:Name="MediaControls"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    Spacing="2"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    IsVisible="False">
          <Button x:Name="MediaPrev"
                  Padding="4,0"
                  Background="Transparent"
                  BorderThickness="0"
                  Click="OnMediaPrev"
                  ToolTip.Tip="Предыдущий"
                  AutomationProperties.Name="Предыдущий трек">
            <TextBlock x:Name="MediaPrevGlyph" Text="⏮" FontSize="11" Foreground="#3D9CF0" VerticalAlignment="Center"/>
          </Button>
          <Button x:Name="MediaPlay"
                  Padding="4,0"
                  Background="Transparent"
                  BorderThickness="0"
                  Click="OnMediaPlay"
                  ToolTip.Tip="Воспроизведение"
                  AutomationProperties.Name="Воспроизведение">
            <TextBlock x:Name="MediaPlayGlyph"
                       Text="▶"
                       FontSize="11"
                       Foreground="#3D9CF0"
                       VerticalAlignment="Center" />
          </Button>
          <Button x:Name="MediaNext"
                  Padding="4,0"
                  Background="Transparent"
                  BorderThickness="0"
                  Click="OnMediaNext"
                  ToolTip.Tip="Следующий"
                  AutomationProperties.Name="Следующий трек">
            <TextBlock x:Name="MediaNextGlyph" Text="⏭" FontSize="11" Foreground="#3D9CF0" VerticalAlignment="Center"/>
          </Button>
        </StackPanel>

        <StackPanel x:Name="TimerControls"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    Spacing="2"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    IsVisible="False">
          <Button x:Name="TimerPauseBtn"
                  Padding="4,0"
                  Background="Transparent"
                  BorderThickness="0"
                  Click="OnTimerPauseResume"
                  ToolTip.Tip="Пауза / продолжить"
                  AutomationProperties.Name="Пауза таймера">
            <TextBlock x:Name="TimerPauseGlyph" Text="||" FontSize="11" Foreground="#3D9CF0" VerticalAlignment="Center"/>
          </Button>
          <Button x:Name="TimerPlusBtn"
                  Padding="4,0"
                  Background="Transparent"
                  BorderThickness="0"
                  Click="OnTimerPlusOne"
                  ToolTip.Tip="+1 мин"
                  AutomationProperties.Name="Добавить минуту">
            <TextBlock x:Name="TimerPlusGlyph" Text="+1" FontSize="10" FontWeight="SemiBold" Foreground="#3D9CF0" VerticalAlignment="Center"/>
          </Button>
          <Button x:Name="TimerCancelBtn"
                  Padding="4,0"
                  Background="Transparent"
                  BorderThickness="0"
                  Click="OnTimerCancel"
                  ToolTip.Tip="Отмена"
                  AutomationProperties.Name="Отменить таймер">
            <TextBlock x:Name="TimerCancelGlyph" Text="✕" FontSize="11" Foreground="#E8A0A0" VerticalAlignment="Center"/>
          </Button>
        </StackPanel>

        <TextBlock x:Name="OverlayTitle"
                   VerticalAlignment="Center"
                   FontFamily="Segoe UI Variable, Inter, Segoe UI"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="#FFFFFF"
                   TextTrimming="CharacterEllipsis"
                   Text="Обзор" />
        <TextBlock x:Name="OverlaySubtitle"
                   IsVisible="False"
                   Height="0"
                   FontSize="1"
                   Text="" />
      </DockPanel>

      <!-- System Stats expanded view (1.12.1): own slot in the root Grid so the
           stats block is never clipped by the single-row overlay layout.
           Rows are built at runtime from the settings list (any subset, any order) —
           see StatsRowView and SyncStatsRows. Spacing/Margin are the numbers
           StatsLayout.StatsHeightFor was derived from; do not change them. -->
      <StackPanel x:Name="SystemStatsPanel"
                  Spacing="4"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsVisible="False"
                  Margin="12,6,12,6" />

      <!-- FontAudio digital-dot seconds strip (Idle/Collapsed); complementary to HH:mm[:ss] -->
      <StackPanel x:Name="SecondsStrip"
                  Orientation="Horizontal"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Bottom"
                  Margin="10,0,10,2"
                  Spacing="1.5"
                  Height="8"
                  IsVisible="False"
                  IsHitTestVisible="False" />

      <ProgressBar x:Name="OverlayProgress"
                   Height="2"
                   Minimum="0" Maximum="100"
                   Foreground="#3D9CF0"
                   Background="Transparent"
                   VerticalAlignment="Bottom"
                   Margin="12,0,12,2"
                   IsVisible="False" />
    </Grid>
  </Border>
</Window>