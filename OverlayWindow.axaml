<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NotifyIsland.OverlayWindow"
        Title="NotifyIsland"
        AutomationProperties.Name="NotifyIsland overlay"
        Width="180" Height="40"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="Transparent"
        Background="Transparent"
        WindowStartupLocation="Manual">
  <Panel Background="Transparent">
    <Border x:Name="Glow"
            Width="188" Height="48"
            CornerRadius="24"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            Opacity="0.28" />
    <Border x:Name="Pill"
            Width="180" Height="40"
            CornerRadius="20"
            ClipToBounds="True"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            PointerPressed="OnPillPressed"
            PointerEntered="OnPillEntered"
            PointerExited="OnPillExited">
      <Grid x:Name="CapsuleGrid" Margin="12,0" ClipToBounds="True">
        <StackPanel x:Name="AppBadge" Orientation="Horizontal" Spacing="3"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Opacity="0">
          <Image x:Name="BadgeLogo" Width="16" Height="16" Stretch="UniformToFill" />
          <Path x:Name="BadgeFallback" Width="14" Height="14" Stretch="Uniform" IsVisible="False" />
          <TextBlock x:Name="BadgeCount" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="ClockText"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   FontFamily="Segoe UI Variable Display, Segoe UI Variable, Segoe UI"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="#FFFFFF"
                   Text="00:00" />
        <StackPanel x:Name="WeatherChip" Orientation="Horizontal" Spacing="4"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Opacity="0" IsHitTestVisible="False" Margin="0,0,2,0"
                    ClipToBounds="True" MaxWidth="56">
          <Panel Width="14" Height="14">
            <Path x:Name="WeatherIcon" Width="13" Height="13" Stretch="Uniform" />
            <TextBlock x:Name="WeatherGlyph" FontFamily="Segoe MDL2 Assets" FontSize="12" IsVisible="False"
                       VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Panel>
          <TextBlock x:Name="WeatherTemp" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <DockPanel x:Name="OverlayRow" LastChildFill="True" Opacity="0" IsHitTestVisible="False">
          <Panel DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
            <Path x:Name="KindIcon" Width="14" Height="14" Stretch="Uniform" />
            <TextBlock x:Name="KindGlyph" FontFamily="Segoe MDL2 Assets" FontSize="13" IsVisible="False"
                       VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Panel>
          <StackPanel x:Name="PlayerChrome" DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2"
                      VerticalAlignment="Center">
            <Slider x:Name="MasterVol" Width="56" Minimum="0" Maximum="1" Height="16"
                    Opacity="0" IsHitTestVisible="False" VerticalAlignment="Center"
                    PropertyChanged="OnMasterVol" />
            <Button x:Name="MediaMute" Padding="3,0" Opacity="0" IsHitTestVisible="False"
                    Click="OnMediaMute" ToolTip.Tip="Mute">
              <Path x:Name="MediaMuteIcon" Width="10" Height="10" Stretch="Uniform" />
            </Button>
            <Button x:Name="MediaPlay" Padding="4,0" Click="OnMediaPlay"
                    Opacity="0" IsHitTestVisible="False" VerticalAlignment="Center"
                    ToolTip.Tip="Play" AutomationProperties.Name="Play">
              <Panel Width="12" Height="12">
                <Path x:Name="MediaPlayIcon" Width="10" Height="10" Stretch="Uniform" />
                <TextBlock x:Name="MediaPlayGlyph" FontFamily="Segoe MDL2 Assets" FontSize="11" IsVisible="False" />
              </Panel>
            </Button>
            <Button x:Name="MediaNext" Padding="3,0" Opacity="0" IsHitTestVisible="False"
                    Click="OnMediaNext" ToolTip.Tip="Next">
              <Path x:Name="MediaNextIcon" Width="10" Height="10" Stretch="Uniform" />
            </Button>
          </StackPanel>
          <ProgressBar x:Name="RowProgress" DockPanel.Dock="Right" Width="52" Height="3" Margin="8,0,0,0"
                       Minimum="0" Maximum="100" Opacity="0" VerticalAlignment="Center" />
          <TextBlock x:Name="RowTimer" DockPanel.Dock="Right" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold"
                     Opacity="0" VerticalAlignment="Center" />
          <Button x:Name="CancelProgress" DockPanel.Dock="Right" Padding="4,0" Margin="6,0,0,0"
                  Opacity="0" IsHitTestVisible="False" Click="OnCancelProgress"
                  AutomationProperties.Name="Cancel" Content="✕" />
          <TextBlock x:Name="RowText" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                     AutomationProperties.Name="Notification text" />
        </DockPanel>
        <DockPanel x:Name="OverlayPanel" LastChildFill="True" Opacity="0" IsHitTestVisible="False">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock x:Name="OverlayTitle" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"
                       FontFamily="Segoe UI Variable Display, Segoe UI Variable, Segoe UI"
                       TextTrimming="CharacterEllipsis" Text="Overview" />
            <TextBlock x:Name="OverlaySubtitle" FontSize="11" Foreground="#C8C8CC"
                       FontFamily="Segoe UI Variable, Segoe UI"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="OverlayStack" FontSize="11" Foreground="#C8C8CC" Opacity="0"
                       FontFamily="Segoe UI Variable, Segoe UI"
                       TextTrimming="CharacterEllipsis" />
            <ProgressBar x:Name="OverlayProgress" Height="4" Minimum="0" Maximum="100" Foreground="#3D9CF0" Opacity="0" />
            <TextBlock x:Name="OverlayTimer" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" Opacity="0"
                       FontFamily="Segoe UI Variable Display, Segoe UI" />
          </StackPanel>
        </DockPanel>
      </Grid>
    </Border>
    <TextBlock x:Name="MotionHud" FontSize="10" Foreground="#A0E0A0" Margin="0,-18,0,0"
               HorizontalAlignment="Center" VerticalAlignment="Top" IsVisible="False"
               IsHitTestVisible="False" />
  </Panel>
</Window>
