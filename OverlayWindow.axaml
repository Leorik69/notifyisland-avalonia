<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NotifyIsland.OverlayWindow"
        Title="NotifyIsland"
        Width="170" Height="30"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="#080808"
        Background="Transparent"
        WindowStartupLocation="Manual">
  <Border x:Name="Pill"
          Width="170" Height="30"
          CornerRadius="15"
          Background="#080808"
          BorderBrush="#28FFFFFF"
          BorderThickness="1"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          ClipToBounds="False"
          RenderTransformOrigin="50%,50%">
    <Grid>
      <!-- Collapsed: time + optional date + optional weather + unread dot (no clock icon) -->
      <StackPanel x:Name="CollapsedRow"
                  Orientation="Horizontal"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="6">
        <TextBlock x:Name="ClockText"
                   VerticalAlignment="Center"
                   FontFamily="Segoe UI Variable, Inter, Segoe UI"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="#FFFFFF"
                   Text="00:00" />
        <TextBlock x:Name="DateText"
                   VerticalAlignment="Center"
                   FontFamily="Segoe UI Variable, Inter, Segoe UI"
                   FontSize="11"
                   FontWeight="Medium"
                   Foreground="#C8C8CC"
                   Text="24 сен" />
        <StackPanel x:Name="MinimalWeather"
                    Orientation="Horizontal"
                    Spacing="4"
                    VerticalAlignment="Center"
                    IsVisible="False">
          <Grid Width="12" Height="12" VerticalAlignment="Center">
            <Viewbox x:Name="WeatherIconA" Width="12" Height="12" Opacity="1" />
            <Viewbox x:Name="WeatherIconB" Width="12" Height="12" Opacity="0" />
          </Grid>
          <TextBlock x:Name="WeatherTempText"
                     VerticalAlignment="Center"
                     FontFamily="Segoe UI Variable, Inter, Segoe UI"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="#C8C8CC"
                     Text="18°" />
        </StackPanel>
        <Border x:Name="UnreadDot"
                Width="7" Height="7"
                CornerRadius="3.5"
                Background="#5CB6FF"
                VerticalAlignment="Center"
                Opacity="0"
                IsHitTestVisible="False"
                BoxShadow="0 0 12 4 #E05CB6FF" />
      </StackPanel>

      <!-- Expanded single-row: icon | title/subtitle | badge -->
      <DockPanel x:Name="OverlayPanel"
                 Margin="10,0,10,0"
                 IsVisible="False"
                 VerticalAlignment="Center">
        <Border x:Name="AppIcon"
                DockPanel.Dock="Left"
                Width="18" Height="18"
                CornerRadius="5"
                Background="#3D9CF0"
                Margin="0,0,8,0"
                VerticalAlignment="Center">
          <Viewbox x:Name="AppIconHost" Width="11" Height="11"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <Border x:Name="UnreadBadge"
                DockPanel.Dock="Right"
                MinWidth="18" Height="18"
                CornerRadius="9"
                Background="#3D9CF0"
                Padding="5,0"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                IsVisible="False">
          <TextBlock x:Name="BadgeText"
                     FontFamily="Segoe UI Variable, Inter, Segoe UI"
                     FontSize="10"
                     FontWeight="SemiBold"
                     Foreground="#FFFFFF"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Text="1" />
        </Border>

        <Button x:Name="MediaPlay"
                DockPanel.Dock="Right"
                Padding="4,0"
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Click="OnMediaPlay"
                ToolTip.Tip="Воспроизведение"
                AutomationProperties.Name="Воспроизведение"
                IsVisible="False">
          <TextBlock x:Name="MediaPlayGlyph"
                     Text="▶"
                     FontSize="11"
                     Foreground="#3D9CF0"
                     VerticalAlignment="Center" />
        </Button>

        <TextBlock x:Name="OverlayTitle"
                   VerticalAlignment="Center"
                   FontFamily="Segoe UI Variable, Inter, Segoe UI"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="#FFFFFF"
                   TextTrimming="CharacterEllipsis"
                   Text="Обзор" />
        <TextBlock x:Name="OverlaySubtitle"
                   IsVisible="False"
                   Height="0"
                   FontSize="1"
                   Text="" />
      </DockPanel>

      <ProgressBar x:Name="OverlayProgress"
                   Height="2"
                   Minimum="0" Maximum="100"
                   Foreground="#3D9CF0"
                   Background="Transparent"
                   VerticalAlignment="Bottom"
                   Margin="12,0,12,2"
                   IsVisible="False" />
    </Grid>
  </Border>
</Window>
