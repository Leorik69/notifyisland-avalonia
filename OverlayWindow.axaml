<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NotifyIsland.OverlayWindow"
        Title="NotifyIsland"
        Width="180" Height="34"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="Transparent"
        Background="Transparent"
        WindowStartupLocation="Manual">
  <Panel>
    <Border x:Name="Glow"
            Width="188" Height="42"
            CornerRadius="21"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsHitTestVisible="False"
            Opacity="0.28" />
    <Border x:Name="Pill"
            Width="180" Height="34"
            CornerRadius="17"
            ClipToBounds="True"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            PointerPressed="OnPillPressed">
      <Grid Margin="12,0">
        <TextBlock x:Name="ClockText"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   FontFamily="Segoe UI Variable Display, Segoe UI Variable, Segoe UI"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="#FFFFFF"
                   Text="00:00" />
        <DockPanel x:Name="OverlayPanel" LastChildFill="True" IsVisible="False">
          <Panel DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
            <Path x:Name="KindIcon" Width="16" Height="16" Stretch="Uniform" />
            <TextBlock x:Name="KindGlyph" FontFamily="Segoe MDL2 Assets" FontSize="14" IsVisible="False"
                       VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Panel>
          <Button x:Name="MediaPlay" DockPanel.Dock="Right" Padding="6,2" Margin="8,0,0,0" Click="OnMediaPlay"
                  ToolTip.Tip="Play" AutomationProperties.Name="Play">
            <Panel Width="12" Height="12">
              <Path x:Name="MediaPlayIcon" Width="10" Height="10" Stretch="Uniform" />
              <TextBlock x:Name="MediaPlayGlyph" FontFamily="Segoe MDL2 Assets" FontSize="11" IsVisible="False" />
            </Panel>
          </Button>
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock x:Name="OverlayTitle" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"
                       FontFamily="Segoe UI Variable Display, Segoe UI Variable, Segoe UI"
                       TextTrimming="CharacterEllipsis" Text="Overview" />
            <TextBlock x:Name="OverlaySubtitle" FontSize="11" Foreground="#C8C8CC"
                       FontFamily="Segoe UI Variable, Segoe UI"
                       TextTrimming="CharacterEllipsis" />
            <ProgressBar x:Name="OverlayProgress" Height="4" Minimum="0" Maximum="100" Foreground="#3D9CF0" />
            <TextBlock x:Name="OverlayTimer" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" IsVisible="False"
                       FontFamily="Segoe UI Variable Display, Segoe UI" />
          </StackPanel>
        </DockPanel>
      </Grid>
    </Border>
  </Panel>
</Window>
