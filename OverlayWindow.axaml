<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NotifyIsland.OverlayWindow"
        Title="NotifyIsland"
        Width="170" Height="30"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="#080808"
        Background="Transparent"
        WindowStartupLocation="Manual">
  <!-- 1.14: буфер — секция самой капсулы (spec: docs/superpowers/specs, 2026-09-30,
       notifyisland-clipboard-section).
       Шарик на верёвке, его drag-диск и бейдж счёта удалены: окно теперь ровно того размера,
       что оно показывает — капсула по длинной оси, капсула+ящик по короткой, — поэтому
       запаса под перетаскивание больше нет и прозрачное окно не может уехать за край.
       Root не хит-тестится, и обратно в игру opt-in'ятся только капсула, секция буфера и
       ящик истории. Порядок детей — это порядок отрисовки. -->
  <Grid x:Name="Root"
        IsHitTestVisible="False">
    <Border x:Name="Pill"
          Width="170" Height="30"
          CornerRadius="15"
          Background="#080808"
          BorderBrush="#16FFFFFF"
          BorderThickness="1"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          ClipToBounds="False"
          RenderTransformOrigin="50%,50%">
    <!-- Island content. The capsule is the island again: 1.12.3 moved the clipboard out of
         the pill into the ball, so this container spans the capsule and nothing else, and the
         ⅓/⅓/⅓ cycle zones and the seconds strip are measured against the capsule's own
         length without any slack compensation. -->
    <Grid x:Name="CollapsedArea">
      <!-- Collapsed: visible ‹/› chevrons + clock/date/weather + unread dot.
           System-stats metrics live in SystemStatsPanel (expanded view only, 1.12.1).
           When clipboard cycle is active (≥2 items), clock is hidden and the
           preview + nav hint take its place; chevrons appear as clickable
           cycle-prev / cycle-next buttons on the edges. -->
      <StackPanel x:Name="CollapsedRow"
                  Orientation="Horizontal"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="6"
                  Margin="20,0,20,0">
        <Button x:Name="CyclePrevButton"
                Classes="cycleChevron"
                VerticalAlignment="Center"
                Padding="6,0"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="#9CC4FF"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                ToolTip.Tip="Предыдущий режим"
                Click="OnCyclePrevClick"
                Content="‹" />
        <TextBlock x:Name="ClockText"
                   VerticalAlignment="Center"
                   FontFamily="Segoe UI Variable, Inter, Segoe UI"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="#FFFFFF"
                   FontFeatures="tnum"
                   Text="00:00" />
        <TextBlock x:Name="CyclePreviewText"
                   VerticalAlignment="Center"
                   FontFamily="Segoe UI Variable, Inter, Segoe UI"
                   FontSize="11"
                   FontWeight="Medium"
                   Foreground="#FFFFFF"
                   IsVisible="False"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="240"
                   Text="preview" />
        <TextBlock x:Name="CycleNavHint"
                   VerticalAlignment="Center"
                   FontFamily="Segoe UI Variable, Inter, Segoe UI"
                   FontSize="10"
                   FontWeight="Medium"
                   Foreground="#888890"
                   IsVisible="False"
                   Text="1/3" />
        <Button x:Name="CycleNextButton"
                Classes="cycleChevron"
                VerticalAlignment="Center"
                Padding="6,0"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="#9CC4FF"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                ToolTip.Tip="Следующий режим"
                Click="OnCycleNextClick"
                Content="›" />
        <!-- FontAudio digital segments (HH:mm[:ss]); toggled vs ClockText via DigitalClockEnabled -->
        <StackPanel x:Name="DigitalClockRow"
                    Orientation="Horizontal"
                    Spacing="1"
                    VerticalAlignment="Center"
                    IsVisible="False"
                    IsHitTestVisible="False" />
        <TextBlock x:Name="DateText"
                   VerticalAlignment="Center"
                   FontFamily="Segoe UI Variable, Inter, Segoe UI"
                   FontSize="10"
                   FontWeight="Medium"
                   Foreground="#C8C8CC"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="120"
                   Text="24 сен" />
        <StackPanel x:Name="MinimalWeather"
                    Orientation="Horizontal"
                    Spacing="4"
                    VerticalAlignment="Center"
                    IsVisible="False">
          <Grid Width="12" Height="12" VerticalAlignment="Center">
            <Viewbox x:Name="WeatherIconA" Width="12" Height="12" Opacity="1" />
            <Viewbox x:Name="WeatherIconB" Width="12" Height="12" Opacity="0" />
          </Grid>
          <TextBlock x:Name="WeatherTempText"
                     VerticalAlignment="Center"
                     FontFamily="Segoe UI Variable, Inter, Segoe UI"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="#C8C8CC"
                     Text="18°" />
        </StackPanel>
        <StackPanel x:Name="MinimalBattery"
                    Orientation="Horizontal"
                    Spacing="3"
                    VerticalAlignment="Center"
                    IsVisible="False">
          <Viewbox x:Name="BatteryIconHost" Width="11" Height="11" VerticalAlignment="Center" />
          <TextBlock x:Name="BatteryPercentText"
                     VerticalAlignment="Center"
                     FontFamily="Segoe UI Variable, Inter, Segoe UI"
                     FontSize="11"
                     FontWeight="SemiBold"
                     Foreground="#C8C8CC"
                     Text="100%" />
        </StackPanel>
        <!-- 1.15: unread dot stays a quiet 6 DIP square in the accent colour. The permanent
             outer glow is gone — a steady halo around a 6 DIP dot read as an alert lamp and
             fought the calm of the capsule. Attention comes from the existing pulse (opacity
             0.40↔1.0), not from a constant light source. -->
        <Border x:Name="UnreadDot"
                Width="6" Height="6"
                CornerRadius="2"
                Background="#3D9CF0"
                VerticalAlignment="Center"
                Opacity="0"
                IsHitTestVisible="False" />
        <Border x:Name="PinnedBadge"
                IsVisible="False"
                CornerRadius="4"
                Background="#28FFFFFF"
                Padding="4,1"
                VerticalAlignment="Center">
          <TextBlock Text="закреп"
                     FontFamily="Segoe UI Variable, Inter, Segoe UI"
                     FontSize="9"
                     FontWeight="SemiBold"
                     Foreground="#C8C8CC" />
        </Border>
      </StackPanel>

      <!-- Expanded single-row: icon | title/subtitle | badge | (system-stats expanded when SystemStats kind) -->
      <DockPanel x:Name="OverlayPanel"
                 Margin="22,0,22,0"
                 IsVisible="False"
                 VerticalAlignment="Center">
        <Border x:Name="AppIcon"
                DockPanel.Dock="Left"
                Width="18" Height="18"
                CornerRadius="5"
                Background="#3D9CF0"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                ClipToBounds="True">
          <Grid>
            <Viewbox x:Name="AppIconHost" Width="11" Height="11"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Image x:Name="MediaArtwork"
                   Stretch="UniformToFill"
                   IsVisible="False"
                   IsHitTestVisible="False"/>
          </Grid>
        </Border>

        <Border x:Name="UnreadBadge"
                DockPanel.Dock="Right"
                MinWidth="18" Height="18"
                CornerRadius="9"
                Background="#3D9CF0"
                Padding="5,0"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                IsVisible="False">
          <TextBlock x:Name="BadgeText"
                     FontFamily="Segoe UI Variable, Inter, Segoe UI"
                     FontSize="10"
                     FontWeight="SemiBold"
                     Foreground="#FFFFFF"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Text="1" />
        </Border>

        <!-- 1.13: the media and timer control clusters were removed from the capsule. Both
             live in their own monitor rows (StatsRowView draws ⏮ ▶ ⏭ and ⏸ +1 ✕ next to
             Плеер / Таймер), because a control cluster on the capsule is what made those two
             take the capsule over in the first place. -->
        <TextBlock x:Name="OverlayTitle"
                   VerticalAlignment="Center"
                   FontFamily="Segoe UI Variable, Inter, Segoe UI"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="#FFFFFF"
                   TextTrimming="CharacterEllipsis"
                   Text="Обзор" />
        <TextBlock x:Name="OverlaySubtitle"
                   IsVisible="False"
                   Height="0"
                   FontSize="1"
                   Text="" />
      </DockPanel>

      <!-- System Stats expanded view (1.12.1): own slot in the root Grid so the
           stats block is never clipped by the single-row overlay layout.
           Rows are built at runtime from the settings list (any subset, any order) —
           see StatsRowView and SyncStatsRows. Spacing/Margin are the numbers
           StatsLayout.StatsHeightFor was derived from; do not change them. -->
      <!-- 1.13.1: the stats block and the running caption now STACK instead of overlapping.
           They used to be siblings anchored independently (panel = Center, caption = Bottom) in
           the same CollapsedArea grid, so the panel centred itself without knowing a caption
           existed and the caption drew straight through the last metric row. The screenshot
           showed the result: «Ночью — Honey Trap» printed on top of «Память 21,8 / 34 ГБ».

           StatsHeightFor already budgets MarqueeTrack.LineH for the caption, so the height was
           right and only the arrangement was wrong. One vertical stack, centred as a unit, makes
           the budget and the layout agree. -->
      <StackPanel x:Name="StatsStack"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Center">
        <StackPanel x:Name="SystemStatsPanel"
                    Spacing="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="False"
                    Margin="22,6,22,6" />

        <!-- 1.13 running caption: the name of whatever the capsule is currently talking about
             (clipboard item, track, timer), in small type, scrolling only if it does not fit.

             It replaces the clipboard preview that used to live in the clock row: that one was
             drawn in the collapsed row and the stats panel then grew straight through it, which
             is why it read as a clipped smear on the last line. Here it has its own slot with
             its own budget (MarqueeTrack.LineH) and a ClipToBounds host, so overflow scrolls
             instead of being cut.

             Shown ONLY inside the monitor (see ApplyMarquee): a 30 DIP Idle capsule has no room
             for a 14 DIP line, and letting it show there drew it across the clock.
             RenderTransformOrigin is pinned to the LEFT edge: a marquee must move the text, not
             scale the box. -->
        <Border x:Name="MarqueeHost"
                Height="14"
                IsVisible="False"
                IsHitTestVisible="False"
                ClipToBounds="True"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Margin="22,0,22,10">
          <TextBlock x:Name="MarqueeText"
                     FontFamily="Segoe UI Variable, Inter, Segoe UI"
                     FontSize="10"
                     FontWeight="Medium"
                     Foreground="#8A8A92"
                     VerticalAlignment="Center"
                     RenderTransformOrigin="0%,50%"
                     TextTrimming="None">
            <TextBlock.RenderTransform>
              <!-- No x:Name here: the shift transform is wired from code (see _marqueeShift field).
                   The Avalonia 11.3 source generator does not register fields for x:Name on
                   transform children of a RenderTransform property. -->
              <TranslateTransform />
            </TextBlock.RenderTransform>
          </TextBlock>
        </Border>
      </StackPanel>

      <!-- FontAudio digital-dot seconds strip (Idle/Collapsed); complementary to HH:mm[:ss].

           1.13: the bottom 8 DIP of the capsule are a SHARED band. ProgressBar (below) and
           SecondsStrip both anchor to VerticalAlignment=Bottom, and only one of them may be
           visible: seconds digits and a moving progress bar are two different readings of the
           same strip, and drawing both reads as a glitch. CapsuleProgressBand decides which
           one gets it. The band is why CollapsedH stays 30 DIP — the progress bar did not
           need a taller capsule, it needed the strip the seconds were already using. -->
      <StackPanel x:Name="SecondsStrip"
                  Orientation="Horizontal"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Bottom"
                  Margin="22,0,22,2"
                  Spacing="1.5"
                  Height="8"
                  IsVisible="False"
                  IsHitTestVisible="False" />

      <!-- 1.13 capsule progress band: 2 DIP bar in the strip the seconds just yielded.
           Value/visibility come from CapsuleProgressBand (owner = clipboard > media > timer).
           Accent is set per owner in Paint so the bar reads as belonging to its source. -->
      <ProgressBar x:Name="OverlayProgress"
                   Height="2"
                   Minimum="0" Maximum="100"
                   Foreground="#3D9CF0"
                   Background="Transparent"
                   VerticalAlignment="Bottom"
                   Margin="22,0,22,2"
                   IsVisible="False" />

      <!-- 1.14: секция буфера — правая часть САМОЙ капсулы. При копировании капсула
           разъезжается на ClipboardSectionW по длинной оси, часы остаются у ведущего края,
           а здесь появляется иконка формата и превью содержимого.
           Живой элемент, а не только чернила: IsHitTestVisible=True и клик по нему открывает
           ящик истории (OverlayWindow.HandleClipboardSectionClick). ClipToBounds — чтобы текст
           обрезался скруглённой крышкой капсулы, а не вылезал за неё; ширина и отступы пишутся
           из кода по ClipboardSection.CapsuleLongAt / OpacityAt. -->
      <Border x:Name="ClipboardSection"
              IsVisible="False"
              IsHitTestVisible="True"
              ClipToBounds="True"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Margin="0,0,15,0"
              Opacity="0"
              Background="Transparent"
              Cursor="Hand"
              ToolTip.Tip="История буфера">
        <StackPanel Orientation="Horizontal"
                    Spacing="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
          <Viewbox x:Name="ClipboardSectionIcon" Width="12" Height="12" VerticalAlignment="Center" />
          <TextBlock x:Name="ClipboardSectionText"
                     VerticalAlignment="Center"
                     FontFamily="Segoe UI Variable, Inter, Segoe UI"
                     FontSize="11"
                     FontWeight="Medium"
                     Foreground="#C8C8CC"
                     TextTrimming="CharacterEllipsis"
                     Text="буфер" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>

    <!-- 1.14: ящик истории буфера. Выезжает из кромки капсулы по короткой оси и остаётся к
         ней примыкающим: та же длинная ось, ноль зазора, а углы на стыке становятся прямыми
         (ClipboardDrawer.CapsuleRadiiFor / DrawerRadiiFor пишут их из кода). Он НЕ отдельное
         окно и НЕ привязан верёвкой — это продолжение капсулы, поэтому одного окна хватает,
         а «ящик» вместо «второй капсулы» читается именно по стыку.
         IsHitTestVisible=False до клика по секции буфера: закрытый ящик не перехватывает
         клики по рабочему столу. Отрисован последним, чтобы перекрыть капсулу, если стык
         разъехался на кадр. -->
    <Border x:Name="HistoryPanel"
            Width="260"
            CornerRadius="12"
            Background="#F2080808"
            BorderBrush="#28FFFFFF"
            BorderThickness="1"
            Padding="10,8"
            IsVisible="False"
            IsHitTestVisible="False"
            ClipToBounds="False"
            Opacity="0"
            RenderTransformOrigin="50%,50%">
      <StackPanel x:Name="HistoryRows"
                  Spacing="0"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top" />
    </Border>
  </Grid>
</Window>