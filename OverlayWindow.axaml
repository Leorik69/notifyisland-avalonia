<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NotifyIsland.OverlayWindow"
        Title="NotifyIsland"
        Width="170" Height="30"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="#080808"
        Background="Transparent"
        WindowStartupLocation="Manual">
  <!-- 1.12.3 goo blob (spec: docs/superpowers/specs/2026-09-29 goo-blob.md).
       The window is now much bigger than the capsule (≈352×264 instead of 170×30): it has to
       hold the ball plus its whole BlobDragMaxPx disc around it. A transparent window that
       large would swallow every click on the desktop behind it, so the root container is
       NOT hit-testable and the two shapes that are — the capsule and the ball — opt back in
       individually. The bridge deliberately stays out: it is drawn *behind* the ball and
       belongs to the ball's drag, not to its own hit area.
       Child order is the paint order: bridge under the capsule and the ball, so the bridge's
       ends are always hidden inside one of them and can never read as detached. -->
  <Grid x:Name="Root"
        IsHitTestVisible="False">
    <!-- Bridge geometry is rebuilt in code every frame from the capsule's edge to the ball's
         centre (see OverlayWindow.UpdateBlobBridge), not declared here: continuity between
         the two shapes is a property of how it is constructed, not of an animation. -->
    <Path x:Name="BlobBridge"
          IsVisible="False"
          IsHitTestVisible="False"
          StrokeThickness="1"
          Fill="#080808"
          Stroke="#28FFFFFF" />
    <Border x:Name="Pill"
          Width="170" Height="30"
          CornerRadius="15"
          Background="#080808"
          BorderBrush="#28FFFFFF"
          BorderThickness="1"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          ClipToBounds="False"
          RenderTransformOrigin="50%,50%">
    <!-- Island content. The capsule is the island again: 1.12.3 moved the clipboard out of
         the pill into the ball, so this container spans the capsule and nothing else, and the
         ⅓/⅓/⅓ cycle zones and the seconds strip are measured against the capsule's own
         length without any slack compensation. -->
    <Grid x:Name="CollapsedArea">
      <!-- Collapsed: visible ‹/› chevrons + clock/date/weather + unread dot.
           System-stats metrics live in SystemStatsPanel (expanded view only, 1.12.1).
           When clipboard cycle is active (≥2 items), clock is hidden and the
           preview + nav hint take its place; chevrons appear as clickable
           cycle-prev / cycle-next buttons on the edges. -->
      <StackPanel x:Name="CollapsedRow"
                  Orientation="Horizontal"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="6">
        <Button x:Name="CyclePrevButton"
                Classes="cycleChevron"
                VerticalAlignment="Center"
                Padding="6,0"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="#9CC4FF"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                ToolTip.Tip="Предыдущий режим"
                Click="OnCyclePrevClick"
                Content="‹" />
        <TextBlock x:Name="ClockText"
                   VerticalAlignment="Center"
                   FontFamily="Segoe UI Variable, Inter, Segoe UI"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="#FFFFFF"
                   Text="00:00" />
        <TextBlock x:Name="CyclePreviewText"
                   VerticalAlignment="Center"
                   FontFamily="Segoe UI Variable, Inter, Segoe UI"
                   FontSize="11"
                   FontWeight="Medium"
                   Foreground="#FFFFFF"
                   IsVisible="False"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="240"
                   Text="preview" />
        <TextBlock x:Name="CycleNavHint"
                   VerticalAlignment="Center"
                   FontFamily="Segoe UI Variable, Inter, Segoe UI"
                   FontSize="10"
                   FontWeight="Medium"
                   Foreground="#888890"
                   IsVisible="False"
                   Text="1/3" />
        <Button x:Name="CycleNextButton"
                Classes="cycleChevron"
                VerticalAlignment="Center"
                Padding="6,0"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="#9CC4FF"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                ToolTip.Tip="Следующий режим"
                Click="OnCycleNextClick"
                Content="›" />
        <!-- FontAudio digital segments (HH:mm[:ss]); toggled vs ClockText via DigitalClockEnabled -->
        <StackPanel x:Name="DigitalClockRow"
                    Orientation="Horizontal"
                    Spacing="1"
                    VerticalAlignment="Center"
                    IsVisible="False"
                    IsHitTestVisible="False" />
        <TextBlock x:Name="DateText"
                   VerticalAlignment="Center"
                   FontFamily="Segoe UI Variable, Inter, Segoe UI"
                   FontSize="11"
                   FontWeight="Medium"
                   Foreground="#C8C8CC"
                   Text="24 сен" />
        <StackPanel x:Name="MinimalWeather"
                    Orientation="Horizontal"
                    Spacing="4"
                    VerticalAlignment="Center"
                    IsVisible="False">
          <Grid Width="12" Height="12" VerticalAlignment="Center">
            <Viewbox x:Name="WeatherIconA" Width="12" Height="12" Opacity="1" />
            <Viewbox x:Name="WeatherIconB" Width="12" Height="12" Opacity="0" />
          </Grid>
          <TextBlock x:Name="WeatherTempText"
                     VerticalAlignment="Center"
                     FontFamily="Segoe UI Variable, Inter, Segoe UI"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="#C8C8CC"
                     Text="18°" />
        </StackPanel>
        <StackPanel x:Name="MinimalBattery"
                    Orientation="Horizontal"
                    Spacing="3"
                    VerticalAlignment="Center"
                    IsVisible="False">
          <Viewbox x:Name="BatteryIconHost" Width="11" Height="11" VerticalAlignment="Center" />
          <TextBlock x:Name="BatteryPercentText"
                     VerticalAlignment="Center"
                     FontFamily="Segoe UI Variable, Inter, Segoe UI"
                     FontSize="11"
                     FontWeight="SemiBold"
                     Foreground="#C8C8CC"
                     Text="100%" />
        </StackPanel>
        <Border x:Name="UnreadDot"
                Width="7" Height="7"
                CornerRadius="3.5"
                Background="#5CB6FF"
                VerticalAlignment="Center"
                Opacity="0"
                IsHitTestVisible="False"
                BoxShadow="0 0 12 4 #E05CB6FF" />
        <Border x:Name="PinnedBadge"
                IsVisible="False"
                CornerRadius="4"
                Background="#28FFFFFF"
                Padding="4,1"
                VerticalAlignment="Center">
          <TextBlock Text="закреп"
                     FontFamily="Segoe UI Variable, Inter, Segoe UI"
                     FontSize="9"
                     FontWeight="SemiBold"
                     Foreground="#C8C8CC" />
        </Border>
      </StackPanel>

      <!-- Expanded single-row: icon | title/subtitle | badge | (system-stats expanded when SystemStats kind) -->
      <DockPanel x:Name="OverlayPanel"
                 Margin="10,0,10,0"
                 IsVisible="False"
                 VerticalAlignment="Center">
        <Border x:Name="AppIcon"
                DockPanel.Dock="Left"
                Width="18" Height="18"
                CornerRadius="5"
                Background="#3D9CF0"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                ClipToBounds="True">
          <Grid>
            <Viewbox x:Name="AppIconHost" Width="11" Height="11"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Image x:Name="MediaArtwork"
                   Stretch="UniformToFill"
                   IsVisible="False"
                   IsHitTestVisible="False"/>
          </Grid>
        </Border>

        <Border x:Name="UnreadBadge"
                DockPanel.Dock="Right"
                MinWidth="18" Height="18"
                CornerRadius="9"
                Background="#3D9CF0"
                Padding="5,0"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                IsVisible="False">
          <TextBlock x:Name="BadgeText"
                     FontFamily="Segoe UI Variable, Inter, Segoe UI"
                     FontSize="10"
                     FontWeight="SemiBold"
                     Foreground="#FFFFFF"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Text="1" />
        </Border>

        <!-- 1.13: the media and timer control clusters were removed from the capsule. Both
             live in their own monitor rows (StatsRowView draws ⏮ ▶ ⏭ and ⏸ +1 ✕ next to
             Плеер / Таймер), because a control cluster on the capsule is what made those two
             take the capsule over in the first place. -->
        <TextBlock x:Name="OverlayTitle"
                   VerticalAlignment="Center"
                   FontFamily="Segoe UI Variable, Inter, Segoe UI"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="#FFFFFF"
                   TextTrimming="CharacterEllipsis"
                   Text="Обзор" />
        <TextBlock x:Name="OverlaySubtitle"
                   IsVisible="False"
                   Height="0"
                   FontSize="1"
                   Text="" />
      </DockPanel>

      <!-- System Stats expanded view (1.12.1): own slot in the root Grid so the
           stats block is never clipped by the single-row overlay layout.
           Rows are built at runtime from the settings list (any subset, any order) —
           see StatsRowView and SyncStatsRows. Spacing/Margin are the numbers
           StatsLayout.StatsHeightFor was derived from; do not change them. -->
      <!-- 1.13.1: the stats block and the running caption now STACK instead of overlapping.
           They used to be siblings anchored independently (panel = Center, caption = Bottom) in
           the same CollapsedArea grid, so the panel centred itself without knowing a caption
           existed and the caption drew straight through the last metric row. The screenshot
           showed the result: «Ночью — Honey Trap» printed on top of «Память 21,8 / 34 ГБ».

           StatsHeightFor already budgets MarqueeTrack.LineH for the caption, so the height was
           right and only the arrangement was wrong. One vertical stack, centred as a unit, makes
           the budget and the layout agree. -->
      <StackPanel x:Name="StatsStack"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Center">
        <StackPanel x:Name="SystemStatsPanel"
                    Spacing="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="False"
                    Margin="12,6,12,6" />

        <!-- 1.13 running caption: the name of whatever the capsule is currently talking about
             (clipboard item, track, timer), in small type, scrolling only if it does not fit.

             It replaces the clipboard preview that used to live in the clock row: that one was
             drawn in the collapsed row and the stats panel then grew straight through it, which
             is why it read as a clipped smear on the last line. Here it has its own slot with
             its own budget (MarqueeTrack.LineH) and a ClipToBounds host, so overflow scrolls
             instead of being cut.

             Shown ONLY inside the monitor (see ApplyMarquee): a 30 DIP Idle capsule has no room
             for a 14 DIP line, and letting it show there drew it across the clock.
             RenderTransformOrigin is pinned to the LEFT edge: a marquee must move the text, not
             scale the box. -->
        <Border x:Name="MarqueeHost"
                Height="14"
                IsVisible="False"
                IsHitTestVisible="False"
                ClipToBounds="True"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Margin="12,0,12,10">
          <TextBlock x:Name="MarqueeText"
                     FontFamily="Segoe UI Variable, Inter, Segoe UI"
                     FontSize="10"
                     FontWeight="Medium"
                     Foreground="#8A8A92"
                     VerticalAlignment="Center"
                     RenderTransformOrigin="0%,50%"
                     TextTrimming="None">
            <TextBlock.RenderTransform>
              <!-- No x:Name here: the shift transform is wired from code (see _marqueeShift field).
                   The Avalonia 11.3 source generator does not register fields for x:Name on
                   transform children of a RenderTransform property. -->
              <TranslateTransform />
            </TextBlock.RenderTransform>
          </TextBlock>
        </Border>
      </StackPanel>

      <!-- FontAudio digital-dot seconds strip (Idle/Collapsed); complementary to HH:mm[:ss].

           1.13: the bottom 8 DIP of the capsule are a SHARED band. ProgressBar (below) and
           SecondsStrip both anchor to VerticalAlignment=Bottom, and only one of them may be
           visible: seconds digits and a moving progress bar are two different readings of the
           same strip, and drawing both reads as a glitch. CapsuleProgressBand decides which
           one gets it. The band is why CollapsedH stays 30 DIP — the progress bar did not
           need a taller capsule, it needed the strip the seconds were already using. -->
      <StackPanel x:Name="SecondsStrip"
                  Orientation="Horizontal"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Bottom"
                  Margin="10,0,10,2"
                  Spacing="1.5"
                  Height="8"
                  IsVisible="False"
                  IsHitTestVisible="False" />

      <!-- 1.13 capsule progress band: 2 DIP bar in the strip the seconds just yielded.
           Value/visibility come from CapsuleProgressBand (owner = clipboard > media > timer).
           Accent is set per owner in Paint so the bar reads as belonging to its source. -->
      <ProgressBar x:Name="OverlayProgress"
                   Height="2"
                   Minimum="0" Maximum="100"
                   Foreground="#3D9CF0"
                   Background="Transparent"
                   VerticalAlignment="Bottom"
                   Margin="12,0,12,2"
                   IsVisible="False" />

      <!-- 1.12.4 phase A: the clipboard preview inside the capsule, the one the split pill
           showed in 1.12.2. It lives INSIDE the capsule and is anchored to its growing end, so
           it is clipped by the capsule (ClipToBounds + the Width OverlayWindow sets from
           ClipboardBlob.PeekWidthAt) instead of spilling over the rounded corner. Icon and text
           are the same ClipboardHalfPreview output the ball uses — no second text rule.
           IsHitTestVisible=False: the capsule is the hit region, the preview is only ink. -->
      <Border x:Name="BlobPeek"
              IsVisible="False"
              IsHitTestVisible="False"
              ClipToBounds="True"
              CornerRadius="15"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Margin="0,0,15,0"
              Opacity="0">
        <StackPanel Orientation="Horizontal"
                    Spacing="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
          <Viewbox x:Name="BlobPeekIcon" Width="12" Height="12" VerticalAlignment="Center" />
          <TextBlock x:Name="BlobPeekText"
                     VerticalAlignment="Center"
                     FontFamily="Segoe UI Variable, Inter, Segoe UI"
                     FontSize="11"
                     FontWeight="Medium"
                     Foreground="#C8C8CC"
                     TextTrimming="CharacterEllipsis"
                     Text="буфер" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>

    <!-- The goo ball. Sized and positioned from code (OverlayTokens.BlobD, ClipboardBlob):
         the margin carries the home spot plus the clamped drag offset, the single
         ScaleTransform carries the ClickPop of the detach. Hit-testable because the user has
         to grab and click it — that is the ONE piece of the enlarged window that is. The row
         inside stays on one line with CharacterEllipsis trimming: a ball is round, so text has
         to be short by construction rather than reflowed.

         1.13 Drag-drop: AllowDrop=true so file drops land here; the handler filters out anything
         that is not an IStorageItem and pushes the rest through WindowsClipboardWriter.
         DoubleTapped re-copies the most recent entry. Right-click opens the clipboard context
         menu. -->
    <Border x:Name="Blob"
            Width="64" Height="64"
            CornerRadius="32"
            Background="#080808"
            BorderBrush="#28FFFFFF"
            BorderThickness="1"
            IsVisible="False"
            IsHitTestVisible="True"
            ClipToBounds="True"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            RenderTransformOrigin="50%,50%">
      <StackPanel Orientation="Horizontal"
                  Spacing="3"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
        <Viewbox x:Name="BlobIcon" Width="13" Height="13" VerticalAlignment="Center" />
        <TextBlock x:Name="BlobText"
                   VerticalAlignment="Center"
                   FontFamily="Segoe UI Variable, Inter, Segoe UI"
                   FontSize="9"
                   FontWeight="Medium"
                   Foreground="#C8C8CC"
                   MaxWidth="26"
                   TextTrimming="CharacterEllipsis"
                   Text="буфер" />
      </StackPanel>
    </Border>

    <!-- 1.13 ball count badge (spec §«Бейджик со счётом»). Sibling of Blob so it can sit at the
         top-right corner of the ball without being clipped by Blob's ClipToBounds. Margin is
         updated in code to track Blob's actual position, the same way Blob.Margin is. Hidden
         when the history holds ≤ 1 items, mirroring the spec. Same accent + contrast as the
         UnreadBadge, so the two read as siblings of one design system. -->
    <Border x:Name="BallCountBadge"
            MinWidth="16" Height="16"
            CornerRadius="8"
            Background="#3D9CF0"
            Padding="4,0"
            VerticalAlignment="Top"
            HorizontalAlignment="Left"
            IsVisible="False"
            IsHitTestVisible="False"
            RenderTransformOrigin="50%,50%">
      <TextBlock x:Name="BallCountText"
                 FontFamily="Segoe UI Variable, Inter, Segoe UI"
                 FontSize="9"
                 FontWeight="SemiBold"
                 Foreground="#FFFFFF"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Text="2" />
    </Border>

    <!-- 1.12.3 clipboard history panel (spec §«Панель истории»): the list a click on the ball
         unfolds. It is a sibling of the capsule and the ball, NOT a second Window — one window
         means one transparent surface, and a second topmost no-activate window would have to
         re-derive the island's position independently and could only ever be a frame late.
         IsHitTestVisible is False until a click opens it, and the Root's own False (line 25)
         is the reason a click on the empty desktop around it still reaches the desktop: only
         the panel itself opts in, exactly like the capsule and the ball do.
         Painted LAST so it occludes the ball if the user drags the ball under it — see
         ClipboardHistoryPanel.BallSideExtent. Rows are built at runtime from
         ClipboardHistoryRows; the text and icons are NOT declared here, they come from the same
         BuildPayload / ClipboardHalfPreview rules the ball uses. -->
    <Border x:Name="HistoryPanel"
            Width="260"
            CornerRadius="12"
            Background="#F2080808"
            BorderBrush="#28FFFFFF"
            BorderThickness="1"
            Padding="10,8"
            IsVisible="False"
            IsHitTestVisible="False"
            ClipToBounds="False"
            Opacity="0"
            RenderTransformOrigin="50%,50%">
      <StackPanel x:Name="HistoryRows"
                  Spacing="0"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top" />
    </Border>
  </Grid>
</Window>